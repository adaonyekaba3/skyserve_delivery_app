{
  "expo": {
    "name": "SkyServe Restaurant",
    "slug": "skyserve-restaurant",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skyserve.restaurant"
    },
    "android": {
      "package": "com.skyserve.restaurant"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-font"
    ]
  }
}
