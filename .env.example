NODE_ENV=development
PORT=3000

# Database (Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Auth (Clerk)
CLERK_SECRET_KEY="sk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."

# Allow `Authorization: Bearer dev-token` outside production for local + simulator usage.
ALLOW_DEV_TOKEN=true

# Realtime (Pusher Channels)
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="mt1"

# Payments (provider-specific)
PAYSTACK_SECRET_KEY="sk_test_..."
PAYSTACK_WEBHOOK_SECRET="paystack_webhook_secret"
FLW_SECRET_KEY="FLWSECK_TEST-..."
FLW_PUBLIC_KEY="FLWPUBK_TEST-..."
FLW_SECRET_HASH="flutterwave_webhook_secret"
FLW_REDIRECT_URL="https://app.skyrunner.ng/payment/callback"
PROVIDUS_BANK_NAME="Providus Bank"
PROVIDUS_ACCOUNT_NAME="Skyrunner Logistics Ltd"
PROVIDUS_ACCOUNT_NUMBER="0000000000"
APP_PUBLIC_URL="http://localhost:3000"
UPLOADS_DIR="./uploads"
